# Copia este archivo a ".env" (en la misma carpeta) y completa tus
# credenciales de OFSC. El archivo ".env" real NUNCA debe compartirse ni
# subirse a control de versiones (ya está listado en .gitignore).
#
# Uso:
#   cp .env.example .env
#   nano .env   (o el editor que prefieras)

OFSC_USERNAME=tu_usuario
OFSC_PASSWORD=tu_clave
